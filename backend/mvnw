#!/usr/bin/env sh
# Lightweight project-local Maven launcher. It prefers an installed Maven and otherwise obtains
# the exact distribution declared in .mvn/wrapper/maven-wrapper.properties.
set -eu

PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if command -v mvn >/dev/null 2>&1; then
  exec mvn "$@"
fi

PROPERTIES="$PROJECT_DIR/.mvn/wrapper/maven-wrapper.properties"
DIST_URL=$(sed -n 's/^distributionUrl=//p' "$PROPERTIES")
DIST_SHA=$(sed -n 's/^distributionSha256Sum=//p' "$PROPERTIES")
DIST_DIR="$PROJECT_DIR/.mvn/wrapper/dists/apache-maven-3.9.12"
MAVEN_BIN="$DIST_DIR/apache-maven-3.9.12/bin/mvn"

if [ ! -x "$MAVEN_BIN" ]; then
  mkdir -p "$DIST_DIR"
  ARCHIVE="$DIST_DIR/apache-maven-3.9.12-bin.tar.gz"
  if command -v curl >/dev/null 2>&1; then
    curl --fail --location --silent --show-error "$DIST_URL" --output "$ARCHIVE"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "$DIST_URL" -O "$ARCHIVE"
  else
    echo "Maven is unavailable and neither curl nor wget can download the wrapper distribution." >&2
    exit 1
  fi
  if [ -n "$DIST_SHA" ] && command -v sha256sum >/dev/null 2>&1; then
    echo "$DIST_SHA  $ARCHIVE" | sha256sum -c -
  fi
  tar -xzf "$ARCHIVE" -C "$DIST_DIR"
fi
exec "$MAVEN_BIN" "$@"
