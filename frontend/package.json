    "@mui/material": "9.4.0",
    "@mui/x-data-grid": "9.4.0",
    "@tanstack/react-query": "^5.90.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.68.0",
    "react-router-dom": "^7.11.0",
    "zod": "^4.1.13"
  },
  "overrides": {
    "@mui/x-internals": "9.0.4"
