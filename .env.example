# Copy this file to .env for local Docker Compose and direct backend development.
# Spring optionally imports it as properties from backend/application.properties.
# Never commit .env.

# PostgreSQL 17.6 (docker-compose.yml)
POSTGRES_DB=profile_directory
POSTGRES_USER=profile_directory
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Spring datasource values for a direct `cd backend && ./mvnw spring-boot:run`.
# They intentionally match the local PostgreSQL container above.
DATABASE_URL=jdbc:postgresql://localhost:5432/profile_directory
DATABASE_USERNAME=profile_directory
DATABASE_PASSWORD=change-me-local-only

# Spring Boot dev profile
SPRING_PROFILES_ACTIVE=dev
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_COOKIE_SECURE=false
APP_JWT_ISSUER=profile-directory-local
APP_REFRESH_TOKEN_PEPPER=replace-with-a-long-local-only-random-value
APP_BOOTSTRAP_ENABLED=true
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
APP_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=Local Administrator

# Production deployment: replace with secrets managed outside the repository.
# Direct Spring Boot deployment uses resource locations:
# APP_COOKIE_SECURE=true
# APP_JWT_PRIVATE_KEY_PATH=file:/secure/path/jwt-private.pem
# APP_JWT_PUBLIC_KEY_PATH=file:/secure/path/jwt-public.pem
# APP_JWT_REQUIRE_KEY_MATERIAL=true
# APP_BOOTSTRAP_ENABLED=false
#
# The included infra/docker-compose.prod.yml instead consumes these host-side
# source-file variables and maps them read-only to /run/secrets/ paths above:
# APP_JWT_PRIVATE_KEY_FILE=/secure/path/jwt-private.pem
# APP_JWT_PUBLIC_KEY_FILE=/secure/path/jwt-public.pem
